# Copier en .env (docker compose) ou saisir ces variables dans la stack Portainer.
# Ne jamais commiter le vrai .env.

TZ=Europe/Paris

# API locale de la Freebox. Si le conteneur ne resout pas ce nom, mettre l'IP de la box.
FBX_URL=http://mafreebox.freebox.fr
FBX_INSECURE=0

# Identite declaree a la Freebox lors de l'appairage
WG_APP_ID=fr.example.wifiguard
WG_APP_NAME=WiFi Guard
WG_DEVICE_NAME=wifi-guard

# Rythme et apprentissage
WG_INTERVAL=60
WG_LEARN_MINUTES=10

# Blocage MAC reel : laisser "off" (alerte seulement) tant que vous n'avez pas lu l'avertissement du README
WG_BLOCK=off

# Appareils (IP / MAC) qui ne seront jamais bloques, separes par des virgules (ex : le serveur qui heberge le conteneur)
WG_PROTECT_IPS=
WG_PROTECT_MACS=

# --- Alerte par mail (SMTP), optionnelle ---
WG_SMTP_HOST=
WG_SMTP_PORT=
WG_SMTP_SECURITY=starttls
WG_SMTP_USER=
WG_SMTP_PASSWORD=
WG_MAIL_FROM=
WG_MAIL_TO=

# --- Alerte par webhook generique (POST JSON), optionnelle ---
WG_WEBHOOK_URL=
# Valeur complete de l'en-tete Authorization si besoin (ex : "Bearer ...")
WG_WEBHOOK_AUTH=
